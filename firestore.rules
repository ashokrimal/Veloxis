rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Pillar 3: Reusable primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.displayName is string
        && data.displayName.size() <= 120
        && (!('email' in data) || (data.email is string && data.email.size() <= 254))
        && data.updatedAt is timestamp;
    }

    function isValidUserSettings(data, userId) {
      return data.keys().hasAll(['ownerUid', 'speedUnit', 'updatedAt'])
        && data.keys().hasOnly([
          'ownerUid',
          'planName',
          'subscribedDownloadMbps',
          'subscribedUploadMbps',
          'monthlyPrice',
          'currencyCode',
          'speedUnit',
          'watchIntervalMin',
          'watchThresholdPct',
          'updatedAt'
        ])
        && data.ownerUid is string
        && data.ownerUid == userId
        && data.ownerUid == request.auth.uid
        && isValidId(data.ownerUid)
        && data.speedUnit in ['Mbps', 'MBps']
        && (!('planName' in data) || (data.planName is string && data.planName.size() <= 80))
        && (!('subscribedDownloadMbps' in data) || data.subscribedDownloadMbps == null || (data.subscribedDownloadMbps is number && data.subscribedDownloadMbps >= 0 && data.subscribedDownloadMbps <= 100000))
        && (!('subscribedUploadMbps' in data) || data.subscribedUploadMbps == null || (data.subscribedUploadMbps is number && data.subscribedUploadMbps >= 0 && data.subscribedUploadMbps <= 100000))
        && (!('monthlyPrice' in data) || data.monthlyPrice == null || (data.monthlyPrice is number && data.monthlyPrice >= 0 && data.monthlyPrice <= 1000000))
        && (!('currencyCode' in data) || (data.currencyCode is string && data.currencyCode.size() <= 8))
        && (!('watchIntervalMin' in data) || (data.watchIntervalMin is number && data.watchIntervalMin >= 0 && data.watchIntervalMin <= 1440))
        && (!('watchThresholdPct' in data) || (data.watchThresholdPct is number && data.watchThresholdPct >= 10 && data.watchThresholdPct <= 100))
        && data.updatedAt is timestamp;
    }

    function isValidSpeedTestRun(data, userId, testId) {
      return data.keys().hasAll([
          'id',
          'ownerUid',
          'timestamp',
          'mode',
          'downloadMbps',
          'uploadMbps',
          'pingMs',
          'loadedPingMs',
          'jitterMs',
          'packetLossPct',
          'veloxisScore',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'id',
          'ownerUid',
          'timestamp',
          'mode',
          'downloadMbps',
          'uploadMbps',
          'pingMs',
          'loadedPingMs',
          'jitterMs',
          'packetLossPct',
          'veloxisScore',
          'bufferbloatGrade',
          'serverNode',
          'isp',
          'country',
          'durationSec',
          'createdAt'
        ])
        && data.id is string
        && data.id == testId
        && isValidId(data.id)
        && data.ownerUid is string
        && data.ownerUid == userId
        && data.ownerUid == request.auth.uid
        && isValidId(data.ownerUid)
        && data.timestamp is string
        && data.timestamp.size() >= 8
        && data.timestamp.size() <= 64
        && data.mode in ['precision', 'file', 'realtime']
        && data.downloadMbps is number && data.downloadMbps >= 0 && data.downloadMbps <= 100000
        && data.uploadMbps is number && data.uploadMbps >= 0 && data.uploadMbps <= 100000
        && data.pingMs is number && data.pingMs >= 0 && data.pingMs <= 30000
        && data.loadedPingMs is number && data.loadedPingMs >= 0 && data.loadedPingMs <= 60000
        && data.jitterMs is number && data.jitterMs >= 0 && data.jitterMs <= 30000
        && data.packetLossPct is number && data.packetLossPct >= 0 && data.packetLossPct <= 100
        && data.veloxisScore is number && data.veloxisScore >= 0 && data.veloxisScore <= 100
        && (!('bufferbloatGrade' in data) || data.bufferbloatGrade in ['A+', 'A', 'B', 'C', 'D', 'F'])
        && (!('serverNode' in data) || (data.serverNode is string && data.serverNode.size() <= 100))
        && (!('isp' in data) || (data.isp is string && data.isp.size() <= 120))
        && (!('country' in data) || (data.country is string && data.country.size() <= 80))
        && (!('durationSec' in data) || (data.durationSec is number && data.durationSec >= 0 && data.durationSec <= 7200))
        && data.createdAt is timestamp;
    }

    function isValidSyncedDevice(data, userId, deviceId) {
      return data.keys().hasAll([
          'deviceId',
          'ownerUid',
          'label',
          'os',
          'browser',
          'deviceType',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'deviceId',
          'ownerUid',
          'label',
          'os',
          'browser',
          'deviceType',
          'linkType',
          'rttMs',
          'bytesDown',
          'bytesUp',
          'downloadMbps',
          'uploadMbps',
          'updatedAt'
        ])
        && data.deviceId is string
        && data.deviceId == deviceId
        && isValidId(data.deviceId)
        && data.ownerUid is string
        && data.ownerUid == userId
        && data.ownerUid == request.auth.uid
        && isValidId(data.ownerUid)
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 80
        && data.os is string && data.os.size() >= 1 && data.os.size() <= 40
        && data.browser is string && data.browser.size() >= 1 && data.browser.size() <= 40
        && data.deviceType in ['Desktop', 'Mobile', 'Tablet']
        && (!('linkType' in data) || (data.linkType is string && data.linkType.size() <= 32))
        && (!('rttMs' in data) || (data.rttMs is number && data.rttMs >= 0 && data.rttMs <= 30000))
        && (!('bytesDown' in data) || (data.bytesDown is number && data.bytesDown >= 0))
        && (!('bytesUp' in data) || (data.bytesUp is number && data.bytesUp >= 0))
        && (!('downloadMbps' in data) || (data.downloadMbps is number && data.downloadMbps >= 0 && data.downloadMbps <= 100000))
        && (!('uploadMbps' in data) || (data.uploadMbps is number && data.uploadMbps >= 0 && data.uploadMbps <= 100000))
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt']);
      allow delete: if isValidId(userId) && isOwner(userId);

      match /settings/{settingId} {
        allow get: if isValidId(userId) && isValidId(settingId) && settingId == 'profile' && isOwner(userId);
        allow list: if false;
        allow create: if isValidId(userId)
          && isValidId(settingId)
          && settingId == 'profile'
          && isOwner(userId)
          && isValidUserSettings(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(settingId)
          && settingId == 'profile'
          && isOwner(userId)
          && isValidUserSettings(incoming(), userId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'planName',
            'subscribedDownloadMbps',
            'subscribedUploadMbps',
            'monthlyPrice',
            'currencyCode',
            'speedUnit',
            'watchIntervalMin',
            'watchThresholdPct',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(settingId) && isOwner(userId);
      }

      match /tests/{testId} {
        allow get: if isValidId(userId) && isValidId(testId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.ownerUid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(testId)
          && isOwner(userId)
          && isValidSpeedTestRun(incoming(), userId, testId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(testId) && isOwner(userId);
      }

      match /devices/{deviceId} {
        allow get: if isValidId(userId) && isValidId(deviceId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.ownerUid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(deviceId)
          && isOwner(userId)
          && isValidSyncedDevice(incoming(), userId, deviceId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(deviceId)
          && isOwner(userId)
          && isValidSyncedDevice(incoming(), userId, deviceId)
          && incoming().deviceId == existing().deviceId
          && incoming().ownerUid == existing().ownerUid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'label',
            'os',
            'browser',
            'deviceType',
            'linkType',
            'rttMs',
            'bytesDown',
            'bytesUp',
            'downloadMbps',
            'uploadMbps',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(deviceId) && isOwner(userId);
      }
    }
  }
}
